<?xml version="1.0" encoding="utf-8"?>
<!--
    O app não faz backup: os vídeos divididos são arquivos temporários e podem
    ser grandes demais para o backup automático. Nada é restaurado nem enviado
    para o Google.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
