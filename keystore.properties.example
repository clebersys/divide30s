# Copie este arquivo para keystore.properties e preencha com as suas credenciais.
# NUNCA faça commit do keystore.properties nem do arquivo .jks.
#
# Gerar um novo keystore:
#   keytool -genkeypair -v -keystore keystore/divide30s-release.jks \
#     -alias divide30s -keyalg RSA -keysize 4096 -validity 10000 \
#     -dname "CN=Seu Nome, O=Divide30s, C=BR"
storeFile=keystore/divide30s-release.jks
storePassword=TROQUE_AQUI
keyAlias=divide30s
keyPassword=TROQUE_AQUI
